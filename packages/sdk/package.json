{
  "name": "@fe-monitor/sdk",
  "version": "1.0.0",
  "description": "前端监控 SDK - 错误 / 性能 / 行为采集",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.sucoupon.com/lihuihao/fe-monitor.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://gitlab.sucoupon.com/lihuihao/fe-monitor/-/tree/main/packages/sdk",
  "bugs": {
    "url": "https://gitlab.sucoupon.com/lihuihao/fe-monitor/-/issues"
  },
  "keywords": [
    "frontend",
    "monitoring",
    "sdk",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
