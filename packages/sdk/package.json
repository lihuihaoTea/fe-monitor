{
  "name": "fe-monitor-kit",
  "version": "1.1.3",
  "description": "前端监控 SDK - 错误 / 性能 / 行为 / 静态资源守卫",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/fe-monitor.min.js",
  "jsdelivr": "./dist/fe-monitor.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./vite": "./vite.mjs",
    "./min": "./dist/fe-monitor.min.js"
  },
  "files": [
    "dist",
    "vite.mjs",
    "README.md"
  ],
  "sideEffects": [
    "./dist/fe-monitor.min.js"
  ],
  "scripts": {
    "build": "pnpm build:modules && pnpm build:iife",
    "build:modules": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:iife": "tsup --config tsup.cdn.config.ts && mv dist/fe-monitor.min.global.js dist/fe-monitor.min.js",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihuihaoTea/fe-monitor.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/lihuihaoTea/fe-monitor/tree/main/packages/sdk",
  "bugs": {
    "url": "https://github.com/lihuihaoTea/fe-monitor/issues"
  },
  "keywords": [
    "frontend",
    "monitoring",
    "sdk",
    "typescript",
    "asset-guard"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
