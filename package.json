{
  "name": "@fe-monitor/sdk",
  "version": "1.0.0",
  "description": "前端监控 SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihuihaoTea/fe-monitor.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/lihuihaoTea/fe-monitor/tree/main/packages/sdk",
  "bugs": {
    "url": "https://github.com/lihuihaoTea/fe-monitor/issues"
  },
  "keywords": ["frontend", "monitoring", "sdk"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
